{
  "name": "nowen-blog",
  "version": "1.0.4",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "seed": "pnpm --filter @blog/server seed",
    "prerender": "pnpm --filter @blog/server prerender",
    "db:migrate": "pnpm --filter @blog/server db:migrate",
    "db:bootstrap": "pnpm --filter @blog/server db:bootstrap",
    "test": "bash scripts/release-docker-entry.test.sh && bash scripts/release-docker-validation.test.sh && bash scripts/release-docker-quick.test.sh && pnpm --filter @blog/server test",
    "test:unit": "pnpm --filter @blog/server test:unit",
    "test:integration": "pnpm --filter @blog/server test:integration",
    "test:e2e": "playwright test",
    "e2e:server": "node scripts/start-e2e-server.mjs",
    "e2e:web": "pnpm --filter @blog/web exec vite --host 127.0.0.1",
    "release:docker": "bash scripts/release-docker-entry.sh",
    "ops:verify-production": "node scripts/ops/verify-production.mjs",
    "ops:verify-docker-persistence": "node scripts/ops/verify-docker-persistence.mjs",
    "ops:email-acceptance": "node scripts/ops/email-acceptance.mjs",
    "ops:backup": "pnpm --filter @blog/server ops:backup",
    "ops:restore": "pnpm --filter @blog/server ops:restore",
    "ops:rehearse-backup": "pnpm --filter @blog/server ops:rehearse-backup"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
