{
  "name": "@blog/server",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "seed": "tsx src/db/seed.ts",
    "prerender": "tsx src/scripts/prerender.ts && tsx src/scripts/prerender-brand.ts",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.json",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:unit": "node --import tsx --test src/lib/format.test.ts src/lib/backup.test.ts src/db/migrations-fresh.test.ts src/db/migrations.test.ts",
    "test:integration": "node --import tsx --test src/modules/comments/comments.e2e.test.ts src/modules/projects/blog19.e2e.test.ts",
    "test:comments": "node --import tsx --test src/modules/comments/comments.e2e.test.ts",
    "ops:backup": "tsx src/scripts/backup.ts",
    "ops:restore": "tsx src/scripts/restore.ts",
    "ops:rehearse-backup": "tsx src/scripts/rehearse-backup.ts"
  },
  "dependencies": {
    "@blog/shared": "workspace:*",
    "@hono/node-server": "^1.13.0",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.5.0",
    "drizzle-orm": "^0.36.0",
    "hono": "^4.6.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.9.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3",
    "unified": "^11.0.5",
    "remark-parse": "^11.0.0",
    "remark-gfm": "^4.0.0",
    "remark-rehype": "^11.1.1",
    "rehype-sanitize": "^6.0.0",
    "rehype-highlight": "^7.0.1",
    "rehype-stringify": "^10.0.1",
    "hast-util-sanitize": "^5.0.0"
  }
}
