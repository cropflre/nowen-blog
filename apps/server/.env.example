PORT=8787
DATABASE_PATH=data/blog.sqlite
BASE_URL=http://localhost:8787

# 默认管理员（仅用于开发环境；生产环境必须设置 ADMIN_PASSWORD）
ADMIN_USERNAME=NOWEN
ADMIN_EMAIL=hi@nowen.dev
ADMIN_PASSWORD=dev-admin-please-change

# 会话签名密钥：生产环境必须显式配置；缺失时开发态使用不安全兜底密钥
SESSION_SECRET=

# 媒体库上传目录（相对 server 工作目录）与单文件大小上限（字节，默认 5MB）
UPLOAD_DIR=data/uploads
MAX_UPLOAD_SIZE=5242880
