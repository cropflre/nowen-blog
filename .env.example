# Public address used by canonical URLs, RSS, sitemap and newsletter links.
BASE_URL=http://localhost:8080
HTTP_PORT=8080

# Required in production. Generate a long random value, for example:
# openssl rand -base64 48
SESSION_SECRET=replace-with-a-long-random-secret

# Created only when the database is empty.
ADMIN_USERNAME=NOWEN
ADMIN_EMAIL=hi@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# Persistent data and verified backup locations.
DATA_VOLUME_NAME=nowen-blog-data
BACKUP_HOST_DIR=./backups

# Optional. Public GitHub repositories can sync without a token, but the rate limit is lower.
GITHUB_TOKEN=
# Used by the production project initialization command/workflow.
GITHUB_SYNC_TARGET=
GITHUB_SYNC_MAX_REPOS=12
# Comma-separated full repository names, names or slugs.
GITHUB_FEATURED_REPOS=

# Optional email delivery through Resend. Subscription collection still works when unset.
RESEND_API_KEY=
NEWSLETTER_FROM_EMAIL="NOWEN Blog <newsletter@example.com>"
NEWSLETTER_REPLY_TO=hi@example.com
# Only used by the explicit email acceptance command/workflow.
EMAIL_SMOKE_TO=

# 10 MiB. The browser normally compresses images before upload.
MAX_UPLOAD_SIZE=10485760
