{
  "name": "nowen-blog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "seed": "pnpm --filter @blog/server seed",
    "prerender": "pnpm --filter @blog/server prerender",
    "db:generate": "pnpm --filter @blog/server db:generate",
    "db:check": "pnpm --filter @blog/server db:check",
    "db:migrate": "pnpm --filter @blog/server db:migrate",
    "test": "pnpm --filter @blog/server test",
    "test:unit": "pnpm --filter @blog/server test:unit",
    "test:integration": "pnpm --filter @blog/server test:integration",
    "test:e2e": "playwright test",
    "e2e:server": "node scripts/start-e2e-server.mjs",
    "e2e:web": "pnpm --filter @blog/web dev -- --host 127.0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["better-sqlite3", "esbuild"]
  }
}
